# Supabase project (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never exposed to the browser. Used by API routes / the sync
# job to bypass RLS. Keep this out of any NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# Google Sheets sync (server-only). Create a Google Cloud service account,
# share the target spreadsheet with its email as Viewer, and paste its
# credentials here.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=1dOfBB8gcZsBR-GTPkYQcOdTbpbXH0MQk0FHuri6uRqY

# BigQuery operational sync (server-only). Same service account works here
# if it also has BigQuery Data Viewer + Job User on the project below.
# Not required for the manual CSV upload workaround on Administración.
BIGQUERY_PROJECT_ID=zb-data-bu-mexico-dev
BIGQUERY_DATASET=1_raw_ext_gsheet
