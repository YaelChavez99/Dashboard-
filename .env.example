# Cloud SQL for SQL Server connection string (server-only). Format:
# sqlserver://HOST:1433;database=DB_NAME;user=USER;password=PASSWORD;encrypt=true
# Unset (or containing "placeholder") makes the app run in demo mode
# (seeded example data, no login) — see src/lib/data/demo-mode.ts.
DATABASE_URL=

# Google Workspace login (NextAuth / Auth.js), restricted to @zubale.com
# accounts — see src/lib/auth.ts. Create an OAuth Client ID in Google
# Cloud Console (Zubale's project) with this app's /api/auth/callback/google
# as an authorized redirect URI.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Google Sheets sync (server-only). Create a Google Cloud service account,
# share the target spreadsheet with its email as Viewer, and paste its
# credentials here.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=1dOfBB8gcZsBR-GTPkYQcOdTbpbXH0MQk0FHuri6uRqY

# BigQuery operational sync (server-only). Same service account works here
# if it also has BigQuery Data Viewer + Job User on the project below.
# Not required for the manual CSV upload workaround on Administración.
BIGQUERY_PROJECT_ID=zb-data-bu-mexico-dev
BIGQUERY_DATASET=1_raw_ext_gsheet
